# GetDruidUser 設定（.env にコピーして編集）
#   cp sample.env .env
# 変数名は zero-plotter と同じ体系に揃えています。

# 計測クエリのバックエンド: druid | bq
BACKEND=druid
DRUID_SQL_URL=http://t2-integ-2:8888/druid/v2/sql
QUERY_TIMEOUT_SEC=120

# zero-plotter 連携（legs_table / BigQuery）
BQ_PROJECT_NAME=t2-integration
BQ_DATASET_NAME=zero_plotter
# Druid モードで legs を取る場合（zero-plotter の nginx が配信する legs_index.jsonl の URL）
#LEGS_JSONL_URL=http://t2-integ-2:8080/legs_index.jsonl

# UI デフォルト
DEFAULT_VEHICLE_ID=giga07
